# Скопируйте в .env и при желании поменяйте. Все порты открыты только на 127.0.0.1.
# Без .env docker-compose возьмёт те же значения по умолчанию.

# Какой готовый набор грузить (каталог в S3): fixture или demo
DATASET=fixture

# Airflow UI
AIRFLOW_PORT=8080
AIRFLOW_USER=student
AIRFLOW_PASSWORD=student

# S3 (RustFS)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=cinema-access
S3_SECRET_KEY=cinema-secret-key

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
# имя пользователя должно совпадать с docker/clickhouse/users.d/cinema_user.xml
CLICKHOUSE_USER=cinema
CLICKHOUSE_PASSWORD=cinema

# Kafka (порт для отладки с хоста; контейнеры ходят на kafka:9092)
KAFKA_EXTERNAL_PORT=9094
