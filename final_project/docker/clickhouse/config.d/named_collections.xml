<!-- Доступ ClickHouse к бакету S3 проекта. -->
<clickhouse>
    <named_collections>
        <cinema_s3>
            <url>http://rustfs:9000/cinema/</url>
            <access_key_id from_env="S3_ACCESS_KEY"/>
            <secret_access_key from_env="S3_SECRET_KEY"/>
        </cinema_s3>
    </named_collections>
</clickhouse>
